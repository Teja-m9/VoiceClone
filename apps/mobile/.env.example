# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to the client bundle.
# NEVER put service-role keys or any server secret here — those live in services/api.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
EXPO_PUBLIC_API_BASE_URL=https://api.realmvp.xyz
EXPO_PUBLIC_SAAVN_API_URL=https://saavn.sumit.co
