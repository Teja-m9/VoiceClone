# Copy to .env and fill in. NEVER commit .env. NEVER read .env in code — only config.py does.

# --- Supabase (server-side; service key bypasses RLS for privileged writes) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- AWS S3 (audio storage: voice samples + generated covers) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
# Leave blank for real AWS; set for an S3-compatible provider (e.g. R2).
S3_ENDPOINT_URL=

# --- Runpod (GPU serverless endpoint running the clone pipeline) ---
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id
RUNPOD_WEBHOOK_SECRET=a-long-random-string

# --- JioSaavn API (resolve song stream URLs server-side) ---
SAAVN_API_URL=https://saavn.sumit.co

# --- Misc ---
API_BASE_URL=https://api.realmvp.xyz
FREE_DAILY_QUOTA=3
PRESIGN_PUT_TTL=600
PRESIGN_GET_TTL=3600
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO
