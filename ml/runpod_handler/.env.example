# The worker downloads inputs and uploads outputs via PRESIGNED URLs supplied in the job
# payload, so it needs NO cloud credentials. Only operational config lives here.
LOG_LEVEL=INFO
# Path to the cloned Seed-VC repo inside the image (set in Dockerfile).
SEED_VC_DIR=/opt/seed-vc
# Demucs model name.
DEMUCS_MODEL=htdemucs
